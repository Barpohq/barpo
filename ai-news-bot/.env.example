# OpenRouter — barcha LLM chaqiruvlar shu orqali o'tadi
OPENROUTER_API_KEY=sk-or-v1-...

# OpenRouter reyting sahifasida ko'rinish uchun (ixtiyoriy)
OPENROUTER_SITE_URL=https://github.com/USERNAME/ai-news-bot
OPENROUTER_SITE_NAME=ai-news-bot

# Tavily — Enricher bosqichida web search uchun.
# Agregatordan (Google News) kelgan yangiliklarda aniq maqola URL'i yo'q,
# sarlavha bo'yicha qidiriladi. Oyiga 1000 so'rov bepul: https://tavily.com
# Bo'sh qoldirilsa Enricher faqat fetch bilan ishlaydi.
TAVILY_API_KEY=tvly-...

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-...
# Kanal (@username yoki -100... raqamli id)
TELEGRAM_CHANNEL_ID=@my_ai_channel
# Approval postlari va health report keladigan shaxsiy chat id
TELEGRAM_ADMIN_CHAT_ID=123456789

# Baza fayli
DB_PATH=data/bot.db

# Log darajasi: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
